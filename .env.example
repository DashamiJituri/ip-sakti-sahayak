# Copy to .env.local and fill in. NEVER commit real keys.
# Free key: https://aistudio.google.com/  (Gemini API). Without a key the app still works in
# "retrieval mode": it shows the exact statute passages with citations, but no AI summary.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Where "Escalate to a human IP facilitator" sends the case summary (mailto link shown to the user)
ESCALATION_EMAIL=ipfacilitator@example.org

# Audit log stores hashes + metadata only. Set to 1 to also store the (PII-redacted) question text.
AUDIT_STORE_TEXT=0
