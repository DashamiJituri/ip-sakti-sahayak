# Copy to .env.local and fill in. NEVER commit real keys — this file is intentionally blank.
# Free key: https://console.groq.com/keys (Groq API, used for the drafting/summarisation
# layer). Without a key the app still works in "retrieval mode": it shows the exact statute
# passages with citations, but no AI-generated summary.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Where "Escalate to a human IP facilitator" sends the case summary (mailto link shown to the user)
ESCALATION_EMAIL=ipfacilitator@example.org

# Audit log stores hashes + metadata only. Set to 1 to also store the (PII-redacted) question text.
AUDIT_STORE_TEXT=0
